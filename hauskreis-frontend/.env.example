# Kopiervorlage für .env.local — alle Werte landen im Browser-Bundle,
# deshalb steht hier nichts Geheimes (kein Client-Secret, kein VAPID-Private-Key).

# Basis der API. Der Präfix /api ist Teil jeder Route und gehört mit hinein.
NEXT_PUBLIC_API_BASE_URL=http://localhost:3000/api

# Keycloak. Der öffentliche Client mit PKCE — nicht "hauskreis-backend",
# der hat ein Secret und einen Service-Account mit Rechten auf der
# Realm-Admin-API und gehört nirgends in Frontend-Code.
NEXT_PUBLIC_OIDC_AUTHORITY=http://localhost:8080/realms/hauskreis
NEXT_PUBLIC_OIDC_CLIENT_ID=hauskreis-app

# Der VAPID-Public-Key steht bewusst nicht hier, sondern wird zur Laufzeit über
# GET /api/push/public-key geholt — so kann er im Backend rotieren, ohne dass
# das Frontend neu gebaut werden muss.
