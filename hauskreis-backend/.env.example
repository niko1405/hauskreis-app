NODE_ENV=development
PORT=3000

# Alle `localhost` hier gelten für die Entwicklung, wo der Server auf dem Host
# läuft und die Dienste aus docker-compose.yml ihre Ports darauf veröffentlichen.
# Läuft der Server selbst im Container, zeigt `localhost` auf den Container —
# docker-compose.prod.yml setzt deshalb überall die Compose-Namen ein.
DATABASE_URL="postgresql://hauskreis:hauskreis@localhost:5432/hauskreis?schema=public"

# Comma-separated list of allowed frontend origins
CORS_ORIGINS=http://localhost:3001

# Keycloak (Phase 1)
# Öffentlich: die Adresse, unter der sich der Browser anmeldet. Daraus wird der
# Issuer gebildet, der exakt dem `iss` im Token entsprechen muss.
KEYCLOAK_URL=http://localhost:8080
# Wie *dieser Prozess* Keycloak erreicht (JWKS, Admin-API). Lokal dieselbe
# Adresse, deshalb leer. Im Compose-Setup: http://keycloak:8080
KEYCLOAK_INTERNAL_URL=
# Wohin Profilbilder geschrieben werden. Im Container ein Volume.
UPLOAD_DIR=./uploads

KEYCLOAK_REALM=hauskreis
KEYCLOAK_CLIENT_ID=hauskreis-backend
KEYCLOAK_CLIENT_SECRET=change-me
# Der Client, unter dem sich der Browser anmeldet.
KEYCLOAK_FRONTEND_CLIENT_ID=hauskreis-app

# Wohin die Einladungsmail zurückführt, wenn Nutzername und Passwort stehen.
# Muss zu einer Redirect-URI von KEYCLOAK_FRONTEND_CLIENT_ID passen.
# Leer lassen heißt: kein Rücksprung, der Ablauf endet bei Keycloak.
APP_URL=http://localhost:3001

# Was im `aud` des Tokens stehen muss. setup-keycloak.sh hängt beiden Clients
# einen Audience-Mapper an, der genau diesen Wert setzt.
KEYCLOAK_AUDIENCE=hauskreis-backend
# Welche Clients Tokens für diese API ausstellen dürfen (`azp`), kommagetrennt.
# Leer heißt: nicht prüfen.
KEYCLOAK_ALLOWED_AZP=hauskreis-app,hauskreis-backend

# Test mode: allows `pnpm db:seed` to load prisma/seed-data/*.csv.
# Must stay false outside local/test environments.
SEED_ENABLED=false

# Web Push (VAPID) — Schlüsselpaar erzeugen mit:
#   npx web-push generate-vapid-keys
# Ohne Schlüssel startet der Server normal, Push ist dann deaktiviert.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@hauskreis.local
