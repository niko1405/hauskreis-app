NODE_ENV=development
PORT=3000

DATABASE_URL="postgresql://hauskreis:hauskreis@localhost:5432/hauskreis?schema=public"

# Comma-separated list of allowed frontend origins
CORS_ORIGINS=http://localhost:3001

# Keycloak (Phase 1)
KEYCLOAK_URL=http://localhost:8080
KEYCLOAK_REALM=hauskreis
KEYCLOAK_CLIENT_ID=hauskreis-backend
KEYCLOAK_CLIENT_SECRET=change-me

# Test mode: allows `pnpm db:seed` to load prisma/seed-data/*.csv.
# Must stay false outside local/test environments.
SEED_ENABLED=false
