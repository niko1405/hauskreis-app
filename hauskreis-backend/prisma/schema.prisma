generator client {
  provider            = "prisma-client"
  output              = "../generated/prisma"
  moduleFormat        = "cjs"
  // Emit extensionless relative imports so the CommonJS build, ts-node and
  // Jest all resolve the generated files without extra mapping.
  importFileExtension = ""
}

datasource db {
  provider = "postgresql"
}

/// A meeting that follows the usual format: one topic, prepared by someone.
/// Generated automatically for every upcoming Tuesday.
///
/// LOBPREIS_GEBET replaces the last standard meeting of each month and carries
/// a testimony (or just songs) instead of a topic.
///
/// CUSTOM is anything the group schedules themselves (birthdays, one-offs) and
/// has no required host, topic or location.
enum MeetingType {
  STANDARD
  LOBPREIS_GEBET
  CUSTOM

  @@map("meeting_type")
}

enum MeetingStatus {
  PLANNED
  CANCELLED
  COMPLETED

  @@map("meeting_status")
}

/// What a notification was about. Together with the person and the related
/// meeting this is what stops the same reminder going out twice.
enum NotificationType {
  HOST_REMINDER
  ACTIONSTEP_REMINDER
  PRAYER_BUDDY_ASSIGNED
  TOPIC_REMINDER

  @@map("notification_type")
}

enum TopicStatus {
  /// Carries over to the next meeting on its own.
  RUNNING
  COMPLETED

  @@map("topic_status")
}

enum AttendanceStatus {
  ATTENDING
  ABSENT
  UNKNOWN

  @@map("attendance_status")
}

model Hauskreis {
  id        String   @id @default(uuid()) @db.Uuid
  name      String
  createdAt DateTime @default(now()) @map("created_at")
  /// Optimistic locking counter, see docs/conditional requests.
  version   Int      @default(0)

  people            Person[]
  locations         Location[]
  meetings          Meeting[]
  topics            Topic[]
  songs             Song[]
  prayerBuddyGroups PrayerBuddyGroup[]
  prayerBuddyConfig PrayerBuddyCycleConfig?

  @@map("hauskreis")
}

model Person {
  id              String    @id @default(uuid()) @db.Uuid
  hauskreisId     String    @map("hauskreis_id") @db.Uuid
  keycloakUserId  String?   @unique @map("keycloak_user_id")
  name            String
  email           String
  birthdate       DateTime? @db.Date
  playsInstrument Boolean   @default(false) @map("plays_instrument")
  canHost         Boolean   @default(true) @map("can_host")
  /// Where this person hosts. Null for anyone who brings no home into the
  /// rotation — they can still take every other role.
  ///
  /// Only ever answers "who lives here *now*". Past evenings are attributed via
  /// `meeting.location_id`, so moving house does not rewrite history.
  locationId      String?   @map("location_id") @db.Uuid
  active          Boolean   @default(true)
  createdAt       DateTime  @default(now()) @map("created_at")
  /// Optimistic locking counter, see docs/conditional requests.
  version         Int       @default(0)

  hauskreis             Hauskreis                @relation(fields: [hauskreisId], references: [id], onDelete: Cascade)
  location              Location?                @relation(fields: [locationId], references: [id], onDelete: SetNull)
  hostedMeetings        Meeting[]                @relation("MeetingHost")
  songsCreated          Song[]                   @relation("SongCreator")
  songLeaderships       MeetingSongLeader[]      @relation("SongLeader")
  songsSuggested        MeetingSong[]            @relation("SongSuggester")
  topicResponsibilities TopicResponsible[]
  prayerBuddyGroups     PrayerBuddyGroupMember[] @relation("PrayerBuddy")
  cycleConfigEdits      PrayerBuddyCycleConfig[] @relation("CycleConfigEditor")
  attendances           MeetingAttendance[]
  pushSubscriptions     PushSubscription[]
  notifications         NotificationLog[]

  @@unique([hauskreisId, email])
  @@index([hauskreisId])
  @@map("person")
}

model Location {
  id           String   @id @default(uuid()) @db.Uuid
  hauskreisId  String   @map("hauskreis_id") @db.Uuid
  name         String
  /// How often this home should come up relative to the others — the few
  /// central ones far more than the occasional ones further out. The weight
  /// belongs to the home, not to its residents: hosting costs the household,
  /// so two people sharing a flat share one weight rather than getting one each.
  ///
  /// `0` keeps a home on the list without it ever being suggested.
  /// Float rather than Decimal — it only feeds a ranking score, and Decimal
  /// would serialise as a string and force the frontend to parse it.
  hostWeight   Float    @default(1.0) @map("host_weight")
  /// How many people fit. Null means "everyone fits", which is the normal case —
  /// only the tight homes need a number.
  ///
  /// A home that is too small for an evening is set aside for that evening only.
  /// It keeps earning its weight in the meantime, unlike a household that is
  /// away: the opportunity was denied by the guest list, not given up.
  capacity     Int?     @map("capacity")
  /// False for places like the Schlosspark — those meetings have no host at all,
  /// which is a valid state rather than missing data. Host-less places are
  /// outside the fairness ranking entirely: they are a weather-dependent option,
  /// not somewhere that is ever "owed" a turn.
  requiresHost Boolean  @default(true) @map("requires_host")
  active       Boolean  @default(true)
  createdAt    DateTime @default(now()) @map("created_at")
  /// Optimistic locking counter, see docs/conditional requests.
  version      Int      @default(0)

  hauskreis Hauskreis @relation(fields: [hauskreisId], references: [id], onDelete: Cascade)
  residents Person[]
  meetings  Meeting[]

  @@unique([hauskreisId, name])
  @@index([hauskreisId])
  @@map("location")
}

model Meeting {
  id             String        @id @default(uuid()) @db.Uuid
  hauskreisId    String        @map("hauskreis_id") @db.Uuid
  date           DateTime      @db.Date
  type           MeetingType   @default(STANDARD)
  status         MeetingStatus @default(PLANNED)
  locationId     String?       @map("location_id") @db.Uuid
  hostPersonId   String?       @map("host_person_id") @db.Uuid
  /// Nullable and shared: a topic can span several meetings, and a
  /// LOBPREIS_GEBET evening has none at all.
  topicId        String?       @map("topic_id") @db.Uuid
  /// Only used by CUSTOM meetings ("Geburtstag von …").
  title          String?
  /// Only used by LOBPREIS_GEBET meetings.
  testimonyText  String?       @map("testimony_text")
  actionstepText String?       @map("actionstep_text")
  summaryText    String?       @map("summary_text")
  infoText       String?       @map("info_text")
  createdAt      DateTime      @default(now()) @map("created_at")
  updatedAt      DateTime      @updatedAt @map("updated_at")
  /// Optimistic locking counter, see docs/conditional requests.
  version        Int           @default(0)

  hauskreis     Hauskreis           @relation(fields: [hauskreisId], references: [id], onDelete: Cascade)
  location      Location?           @relation(fields: [locationId], references: [id], onDelete: SetNull)
  host          Person?             @relation("MeetingHost", fields: [hostPersonId], references: [id], onDelete: SetNull)
  topic         Topic?              @relation(fields: [topicId], references: [id], onDelete: SetNull)
  attendances   MeetingAttendance[]
  songLeaders   MeetingSongLeader[]
  songs         MeetingSong[]
  notifications NotificationLog[]

  /// One meeting per date per group — this is what makes the generator idempotent.
  @@unique([hauskreisId, date])
  @@index([hauskreisId, date])
  @@map("meeting")
}

/// A subject the group works through. Deliberately *not* tied one-to-one to a
/// meeting: a topic may run over several evenings, and while it is RUNNING the
/// next meeting is prefilled with it.
model Topic {
  id          String      @id @default(uuid()) @db.Uuid
  hauskreisId String      @map("hauskreis_id") @db.Uuid
  /// Optional — not everyone settles on a title in advance.
  title       String?
  status      TopicStatus @default(RUNNING)
  createdAt   DateTime    @default(now()) @map("created_at")
  updatedAt   DateTime    @updatedAt @map("updated_at")
  /// Optimistic locking counter, see docs/conditional requests.
  version     Int         @default(0)

  hauskreis    Hauskreis          @relation(fields: [hauskreisId], references: [id], onDelete: Cascade)
  responsibles TopicResponsible[]
  meetings     Meeting[]

  @@index([hauskreisId, status])
  @@map("topic")
}

/// Who prepares a topic — one or two people. A join table rather than two
/// nullable columns, so a third would not need a migration.
model TopicResponsible {
  topicId  String @map("topic_id") @db.Uuid
  personId String @map("person_id") @db.Uuid

  topic  Topic  @relation(fields: [topicId], references: [id], onDelete: Cascade)
  person Person @relation(fields: [personId], references: [id], onDelete: Cascade)

  @@id([topicId, personId])
  @@index([personId])
  @@map("topic_responsible")
}

/// A song the group knows. The database grows by itself: whatever gets
/// suggested once stays and can be picked again (CLAUDE.md §6).
///
/// Lyrics are deliberately not stored — only a link to wherever they live.
model Song {
  id                String   @id @default(uuid()) @db.Uuid
  hauskreisId       String   @map("hauskreis_id") @db.Uuid
  title             String
  artist            String?
  lyricsUrl         String?  @map("lyrics_url")
  createdByPersonId String?  @map("created_by_person_id") @db.Uuid
  createdAt         DateTime @default(now()) @map("created_at")
  /// Optimistic locking counter, see docs/conditional requests.
  version           Int      @default(0)

  hauskreis Hauskreis     @relation(fields: [hauskreisId], references: [id], onDelete: Cascade)
  createdBy Person?       @relation("SongCreator", fields: [createdByPersonId], references: [id], onDelete: SetNull)
  pickedIn  MeetingSong[]

  /// Same title *and* artist twice is a duplicate, not a second song. Two songs
  /// sharing a title by different artists stay separate.
  @@unique([hauskreisId, title, artist])
  @@index([hauskreisId])
  @@map("song")
}

/// Who looks after the music for one evening. At least one person where there
/// are songs at all, and several are fine (CLAUDE.md §6).
model MeetingSongLeader {
  meetingId String @map("meeting_id") @db.Uuid
  personId  String @map("person_id") @db.Uuid

  meeting Meeting @relation(fields: [meetingId], references: [id], onDelete: Cascade)
  person  Person  @relation("SongLeader", fields: [personId], references: [id], onDelete: Cascade)

  @@id([meetingId, personId])
  @@index([personId])
  @@map("meeting_song_leader")
}

/// A song put forward for one evening. `isSelected` separates the shortlist
/// from what actually gets sung, so a suggestion that did not make it stays
/// visible rather than being deleted.
model MeetingSong {
  id                  String   @id @default(uuid()) @db.Uuid
  meetingId           String   @map("meeting_id") @db.Uuid
  songId              String   @map("song_id") @db.Uuid
  suggestedByPersonId String?  @map("suggested_by_person_id") @db.Uuid
  isSelected          Boolean  @default(false) @map("is_selected")
  createdAt           DateTime @default(now()) @map("created_at")

  meeting     Meeting @relation(fields: [meetingId], references: [id], onDelete: Cascade)
  song        Song    @relation(fields: [songId], references: [id], onDelete: Cascade)
  suggestedBy Person? @relation("SongSuggester", fields: [suggestedByPersonId], references: [id], onDelete: SetNull)

  /// One entry per song per evening — suggesting it twice is the same wish.
  @@unique([meetingId, songId])
  @@index([songId])
  @@map("meeting_song")
}

/// How long a prayer buddy assignment lasts. One row per group, created on
/// first read — a separate table rather than a column on `hauskreis` because it
/// records *who* changed the rhythm and when.
model PrayerBuddyCycleConfig {
  id                String   @id @default(uuid()) @db.Uuid
  hauskreisId       String   @unique @map("hauskreis_id") @db.Uuid
  periodLengthWeeks Int      @default(2) @map("period_length_weeks")
  updatedByPersonId String?  @map("updated_by_person_id") @db.Uuid
  updatedAt         DateTime @updatedAt @map("updated_at")
  /// Optimistic locking counter, see docs/conditional requests.
  version           Int      @default(0)

  hauskreis Hauskreis @relation(fields: [hauskreisId], references: [id], onDelete: Cascade)
  updatedBy Person?   @relation("CycleConfigEditor", fields: [updatedByPersonId], references: [id], onDelete: SetNull)

  @@map("prayer_buddy_cycle_config")
}

/// One prayer buddy group for one period. Several rows share a period —
/// together they are the assignment for that stretch of time.
model PrayerBuddyGroup {
  id          String    @id @default(uuid()) @db.Uuid
  hauskreisId String    @map("hauskreis_id") @db.Uuid
  periodStart DateTime  @map("period_start") @db.Date
  periodEnd   DateTime  @map("period_end") @db.Date
  /// Set when an admin re-rolled before this grouping ever took effect. It is
  /// kept rather than deleted: "not this one" is exactly what the next roll
  /// needs to know, otherwise re-rolling returns the identical grouping.
  /// Hidden from the archive, counted by the repeat avoidance.
  discardedAt DateTime? @map("discarded_at")
  createdAt   DateTime  @default(now()) @map("created_at")

  hauskreis     Hauskreis                @relation(fields: [hauskreisId], references: [id], onDelete: Cascade)
  members       PrayerBuddyGroupMember[]
  notifications NotificationLog[]

  @@index([hauskreisId, periodStart])
  @@map("prayer_buddy_group")
}

model PrayerBuddyGroupMember {
  groupId  String @map("prayer_buddy_group_id") @db.Uuid
  personId String @map("person_id") @db.Uuid

  group  PrayerBuddyGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)
  person Person           @relation("PrayerBuddy", fields: [personId], references: [id], onDelete: Cascade)

  @@id([groupId, personId])
  @@index([personId])
  @@map("prayer_buddy_group_member")
}

/// One Web Push endpoint, i.e. one browser on one device. People install the
/// PWA on several devices, so a person can have many.
model PushSubscription {
  id        String   @id @default(uuid()) @db.Uuid
  personId  String   @map("person_id") @db.Uuid
  /// The push service URL. Unique because re-subscribing in the same browser
  /// yields the same endpoint and must update rather than duplicate.
  endpoint  String   @unique
  p256dhKey String   @map("p256dh_key")
  authKey   String   @map("auth_key")
  userAgent String?  @map("user_agent")
  createdAt DateTime @default(now()) @map("created_at")

  person Person @relation(fields: [personId], references: [id], onDelete: Cascade)

  @@index([personId])
  @@map("push_subscription")
}

/// Records that a notification was sent, so a job that runs daily does not
/// remind the same person about the same meeting over and over.
model NotificationLog {
  id               String           @id @default(uuid()) @db.Uuid
  personId         String           @map("person_id") @db.Uuid
  type             NotificationType
  relatedMeetingId String?          @map("related_meeting_id") @db.Uuid
  /// What a prayer buddy notification refers to. Without it every rotation
  /// would look like the same notification as the first one, and only the very
  /// first assignment would ever be announced.
  relatedGroupId   String?          @map("related_group_id") @db.Uuid
  sentAt           DateTime         @default(now()) @map("sent_at")

  person         Person            @relation(fields: [personId], references: [id], onDelete: Cascade)
  relatedMeeting Meeting?          @relation(fields: [relatedMeetingId], references: [id], onDelete: Cascade)
  relatedGroup   PrayerBuddyGroup? @relation(fields: [relatedGroupId], references: [id], onDelete: Cascade)

  /// The deduplication key. Postgres treats rows with a NULL in the tuple as
  /// distinct, so this index does not actually enforce anything for
  /// notifications without a meeting — the real check is the query in
  /// `NotificationService.hasBeenSent`. The index still earns its keep by
  /// making that query an index lookup.
  @@unique([personId, type, relatedMeetingId, relatedGroupId])
  @@index([personId, sentAt])
  @@map("notification_log")
}

model MeetingAttendance {
  meetingId String           @map("meeting_id") @db.Uuid
  personId  String           @map("person_id") @db.Uuid
  status    AttendanceStatus @default(UNKNOWN)
  updatedAt DateTime         @updatedAt @map("updated_at")

  meeting Meeting @relation(fields: [meetingId], references: [id], onDelete: Cascade)
  person  Person  @relation(fields: [personId], references: [id], onDelete: Cascade)

  @@id([meetingId, personId])
  @@index([personId])
  @@map("meeting_attendance")
}
