generator client {
  provider            = "prisma-client"
  output              = "../generated/prisma"
  moduleFormat        = "cjs"
  // Emit extensionless relative imports so the CommonJS build, ts-node and
  // Jest all resolve the generated files without extra mapping.
  importFileExtension = ""
}

datasource db {
  provider = "postgresql"
}

/// A meeting that follows the usual format: one topic, prepared by someone.
/// Generated automatically for every upcoming Tuesday.
///
/// LOBPREIS_GEBET replaces the last standard meeting of each month and carries
/// a testimony (or just songs) instead of a topic.
///
/// CUSTOM is anything the group schedules themselves (birthdays, one-offs) and
/// has no required host, topic or location.
enum MeetingType {
  STANDARD
  LOBPREIS_GEBET
  CUSTOM

  @@map("meeting_type")
}

enum MeetingStatus {
  PLANNED
  CANCELLED
  COMPLETED

  @@map("meeting_status")
}

/// Was jemand **in diesem Hauskreis** darf.
///
/// Bis eben war „Admin" eine Realm-Rolle in Keycloak und galt damit überall.
/// Sobald sich jemand einen eigenen Hauskreis anlegt, stimmt das nicht mehr:
/// er ist dort Admin und im alten Mitglied. Die Rolle gehört deshalb an die
/// Mitgliedschaft, nicht an den Menschen.
enum PersonRole {
  MEMBER
  ADMIN

  @@map("person_role")
}

/// Die drei Aufgaben, die an einem Abend vergeben werden.
///
/// Bis eben nur ein TypeScript-Objekt in `role-assignment.types.ts`. Seit die
/// Benachrichtigungs-Historie sich merken muss, *welche* Rolle jemand bekommen
/// hat, steht sie in der Datenbank — und die Vorschlagslogik leitet ihre
/// Fassung davon ab, statt sie ein zweites Mal aufzuschreiben.
///
/// Gebetsbuddys fehlen hier bewusst: sie hängen an keinem Termin und werden
/// nicht zugeteilt, sondern gewürfelt.
enum AssignmentRole {
  HOST
  TOPIC
  SONG
  /// Wer an einem Lobpreis-/Gebetsabend seine Geschichte erzählt. Steht neben
  /// TOPIC und nie mit ihm zusammen: ein Abend hat entweder ein Thema oder ein
  /// Testimony, nicht beides.
  TESTIMONY

  @@map("assignment_role")
}

/// Wer den Abend abgesagt hat — ein Mensch oder der Umstand.
enum MeetingCancelSource {
  /// Ein Admin hat abgesagt. Bleibt abgesagt, bis ein Admin es zurücknimmt.
  MANUAL
  /// Jede aktive Person hatte abgesagt. Sagt wieder jemand zu, lebt der Abend
  /// von selbst auf — sonst müsste jemand eine Absage zurücknehmen, die nie
  /// jemand ausgesprochen hat.
  ALL_DECLINED

  @@map("meeting_cancel_source")
}

/// What a notification was about. Together with the person and the related
/// meeting this is what stops the same reminder going out twice.
/// Every value needs a matching entry in `notification-catalog.ts` — that is
/// what puts it into the settings screen with a label and a default. A value
/// without an entry fails a unit test rather than silently becoming invisible.
enum NotificationType {
  /// Ahead of the meeting you are hosting.
  HOST_REMINDER
  /// Ahead of the meeting whose topic you prepare.
  TOPIC_REMINDER
  /// Ahead of the meeting whose songs you lead.
  SONG_REMINDER
  /// Mid-week nudge about the actionstep from the last meeting.
  ACTIONSTEP_REMINDER
  /// A new prayer buddy rotation started.
  PRAYER_BUDDY_ASSIGNED
  /// Someone put you down for hosting, the topic or the music.
  ROLE_ASSIGNED
  /// A whole meeting was called off.
  MEETING_CANCELLED
  /// Someone dropped out of a meeting you are hosting.
  ATTENDANCE_DECLINED
  /// Enough people dropped out that a home too small to host now fits.
  HOST_CAPACITY_UNLOCKED
  /// Jemand hat den Hauskreis verlassen.
  MEMBER_LEFT
  /// Ein besonderer Termin wurde von Hand angelegt.
  CUSTOM_MEETING_CREATED
  /// Ein besonderer Termin steht bevor — an alle, nicht nur an Zuständige.
  CUSTOM_MEETING_REMINDER
  /// Ahead of the meeting where you tell your story.
  TESTIMONY_REMINDER
  /// Der nächste Abend fängt zu einer anderen Zeit an als bisher.
  MEETING_TIME_CHANGED
  /// Es gibt eine neue Fassung der App und etwas Neues darin zu sehen.
  RELEASE_NOTES
  /// Du besorgst jetzt das Geschenk für jemanden — oder eben nicht mehr.
  BIRTHDAY_GIFT_ASSIGNED
  /// Der Geburtstag, für den du das Geschenk besorgst, rückt näher.
  BIRTHDAY_GIFT_REMINDER
  /// Für einen Geburtstag steht fest, was es wird — oder was es gekostet hat.
  BIRTHDAY_GIFT_DECIDED

  @@map("notification_type")
}

/// Ob die Gruppe mit einem Thema durch ist.
///
/// Belegt keinen Abend mehr von selbst vor — das tat einmal ein nächtlicher Lauf
/// und stand damit dem „wer zuerst wählt, wird Owner" im Weg. Der Status sortiert
/// jetzt die Auswahl: ein laufendes eigenes Thema steht ganz oben, wenn jemand
/// für einen Abend zugeteilt ist und sich entscheidet.
enum TopicStatus {
  RUNNING
  COMPLETED

  @@map("topic_status")
}

enum AttendanceStatus {
  ATTENDING
  ABSENT
  UNKNOWN

  @@map("attendance_status")
}

enum AttendanceSource {
  /// The person answered for this evening themselves. Never overwritten by an
  /// absence period — a deliberate answer outranks a blanket date range.
  SELF
  /// Derived from an absence period covering this date.
  ABSENCE
  /// Vorab zugesagt, weil die Person „ich bin grundsätzlich dabei" eingestellt
  /// hat. Ein eigener Wert und nicht `SELF`: eine `SELF`-Zeile weicht keinem
  /// Abwesenheitszeitraum, und als `SELF` gespeichert machte die Voreinstellung
  /// jeden Urlaub still wirkungslos. Eine Antwort von Hand gewinnt weiter.
  AUTO

  @@map("attendance_source")
}

model Hauskreis {
  id        String   @id @default(uuid()) @db.Uuid
  name      String
  createdAt DateTime @default(now()) @map("created_at")
  /// Optimistic locking counter, see docs/conditional requests.
  version   Int      @default(0)

  people               Person[]
  locations            Location[]
  meetings             Meeting[]
  topics               Topic[]
  songs                Song[]
  prayerBuddyGroups    PrayerBuddyGroup[]
  prayerBuddyConfig    PrayerBuddyCycleConfig?
  meetingSchedule      MeetingScheduleConfig?
  absences             AbsencePeriod[]
  headerImages         HeaderImage[]
  birthdayGiftConfig   BirthdayGiftConfig?
  birthdayGiftPairings BirthdayGiftPairing[]
  birthdayOccasions    BirthdayOccasion[]
  giftIdeas            GiftIdea[]

  @@map("hauskreis")
}

model Person {
  id              String     @id @default(uuid()) @db.Uuid
  hauskreisId     String     @map("hauskreis_id") @db.Uuid
  /// **Global** eindeutig, und das ist die Regel, nicht ein Hindernis: ein
  /// Mensch gehört zu genau einem Hauskreis. Ein Wechsel ist ein Umzug.
  ///
  /// Wer geht, gibt diesen Platz wieder frei (`null`) und wird `active = false`
  /// — die Zeile bleibt, damit vergangene Abende weiter zeigen, wer gehostet
  /// hat. Eine offene Einladung hat aus demselben Grund noch keine Id: sie
  /// nimmt niemandem seine Mitgliedschaft weg, bis sie angenommen wird.
  keycloakUserId  String?    @unique @map("keycloak_user_id")
  /// Der Name, mit dem man sich anmeldet — derselbe wie in Keycloak.
  ///
  /// **Global** eindeutig, weil Keycloak es realmweit erzwingt: zwei Wahrheiten
  /// über denselben Namen wären genau das Problem, das dieses Feld schließt.
  /// Gesetzt beim ersten Anmelden aus `preferred_username`; wird er hier
  /// geändert, wandert die Änderung nach Keycloak zurück.
  ///
  /// Getrennt von `name`, weil Keycloak auf Kleinschreibung normalisiert —
  /// „niko" stünde sonst auf jeder Karte und in jeder Benachrichtigung.
  username        String?    @unique
  /// Der **Anzeigename**: was auf Karten, Avataren und in „Du bist dran" steht.
  name            String
  /// Wann das Profilbild zuletzt geschrieben wurde — `null` heißt: keins, dann
  /// zeigt die App Initialen mit einer aus der Id abgeleiteten Farbe.
  ///
  /// Der Zeitstempel und nicht der Dateiname steht in der Antwort: die Datei
  /// heißt immer `{id}.webp`, und ein Name, der sich nie ändert, wäre für den
  /// Browser für immer dasselbe Bild. So hängt er als Query-Parameter an der
  /// URL und das Zwischenspeichern erledigt sich von selbst.
  photoUpdatedAt  DateTime?  @map("photo_updated_at")
  /// `null` heißt **anonymisiert** — jemand hat sein Konto gelöscht.
  ///
  /// Nullable, damit die Zeile bleiben kann, wenn die Person geht. Ein hartes
  /// `delete` nähme zwei verschiedene Dinge mit: die Zuschreibung steht auf
  /// `SetNull` (der Abend verlöre seinen Gastgeber), die Mitgliedschaft auf
  /// `Cascade` (wer welche Einheit gehalten hat, wäre weg). Das Archiv wäre
  /// danach nicht anonym, sondern löchrig.
  ///
  /// Der zusammengesetzte Index trägt beliebig viele davon: in Postgres ist
  /// `NULL` in einem eindeutigen Index von jedem anderen `NULL` verschieden —
  /// dieselbe Eigenschaft, auf der schon `topic_session.meeting_id` steht.
  email           String?
  /// Wann das Konto gelöscht wurde. Neben `active = false` nötig, weil ein
  /// **Austritt** den Namen im Archiv behält und ein Löschen nicht.
  anonymizedAt    DateTime?  @map("anonymized_at")
  /// Gilt nur hier. Siehe `PersonRole`.
  role            PersonRole @default(MEMBER)
  birthdate       DateTime?  @db.Date
  playsInstrument Boolean    @default(false) @map("plays_instrument")
  canHost         Boolean    @default(true) @map("can_host")
  /// „Ich bin grundsätzlich dabei." Sagt kommende Abende im Voraus zu, solange
  /// nichts anderes dasteht — ein Abwesenheitszeitraum sticht weiter, eine
  /// Antwort von Hand erst recht. Vorgabe `false`: eine Zusage, die man nie
  /// gegeben hat, ist keine.
  autoAttend      Boolean    @default(false) @map("auto_attend")
  /// Where this person hosts. Null for anyone who brings no home into the
  /// rotation — they can still take every other role.
  ///
  /// Only ever answers "who lives here *now*". Past evenings are attributed via
  /// `meeting.location_id`, so moving house does not rewrite history.
  locationId      String?    @map("location_id") @db.Uuid
  active          Boolean    @default(true)
  /// Wann sich diese Person zum ersten Mal angemeldet hat.
  ///
  /// `null` heißt „eingeladen, aber noch nicht da". Die `keycloakUserId` taugt
  /// dafür nicht: die steht schon ab dem Einladen drin, weil das Konto vor der
  /// Person angelegt wird. Gesetzt wird es in `resolveForUser` — der einzige
  /// Moment, in dem feststeht, dass wirklich jemand vor dem Bildschirm saß.
  acceptedAt      DateTime?  @map("accepted_at")
  createdAt       DateTime   @default(now()) @map("created_at")
  /// Optimistic locking counter, see docs/conditional requests.
  version         Int        @default(0)

  hauskreis               Hauskreis                 @relation(fields: [hauskreisId], references: [id], onDelete: Cascade)
  location                Location?                 @relation(fields: [locationId], references: [id], onDelete: SetNull)
  hostedMeetings          Meeting[]                 @relation("MeetingHost")
  testimonies             Meeting[]                 @relation("MeetingTestimony")
  cancelledMeetings       Meeting[]                 @relation("MeetingCanceller")
  songsCreated            Song[]                    @relation("SongCreator")
  songLeaderships         MeetingSongLeader[]       @relation("SongLeader")
  songsSuggested          MeetingSong[]             @relation("SongSuggester")
  /// Die Rolle „Thema" an einem einzelnen Abend — das Gegenstück zu
  /// `songLeaderships`. Zuständigkeit für einen Abend, nicht für ein Thema.
  topicDuties             MeetingTopicResponsible[]
  /// Wer eine einzelne Einheit gehalten hat. Historisch und rückwirkend
  /// unantastbar (Spec 8.5): auch wer später als Collaborator entfernt wird,
  /// bleibt hier stehen — er war ja dabei.
  topicSessionsHeld       TopicSessionResponsible[]
  /// Themen, die dieser Person gehören. Wer als Erster wählt, wird Owner.
  topicsOwned             Topic[]                   @relation("TopicOwner")
  /// Themen, an denen die Person mitarbeiten darf. Ein Recht, keine Pflicht.
  topicCollaborations     TopicCollaborator[]
  prayerBuddyGroups       PrayerBuddyGroupMember[]  @relation("PrayerBuddy")
  cycleConfigEdits        PrayerBuddyCycleConfig[]  @relation("CycleConfigEditor")
  meetingScheduleEdits    MeetingScheduleConfig[]   @relation("MeetingScheduleEditor")
  attendances             MeetingAttendance[]
  actionstepsDone         MeetingActionstepDone[]   @relation("ActionstepDoneBy")
  prayerRequests          MeetingPrayerRequest[]    @relation("PrayerRequestBy")
  pushSubscriptions       PushSubscription[]
  notifications           NotificationLog[]
  notificationsAbout      NotificationLog[]         @relation("NotificationSubject")
  notificationSettings    NotificationPreference[]
  absences                AbsencePeriod[]
  /// Die eigenen Geburtstage, einer je Jahr. Historie und der kommende.
  birthdays               BirthdayOccasion[]        @relation("BirthdayOf")
  /// Für wessen Geschenk diese Person zuständig ist — auch das rückwirkend.
  giftDuties              BirthdayOccasion[]        @relation("BirthdayGiftBy")
  giftIdeasFor            GiftIdea[]                @relation("GiftIdeaFor")
  giftIdeasProposed       GiftIdea[]                @relation("GiftIdeaBy")
  giftIdeaVotes           GiftIdeaVote[]            @relation("GiftIdeaVoter")
  giftPairingFor          BirthdayGiftPairing[]     @relation("GiftPairingFor")
  giftPairingBy           BirthdayGiftPairing[]     @relation("GiftPairingBy")
  birthdayGiftConfigEdits BirthdayGiftConfig[]      @relation("BirthdayGiftConfigEditor")

  @@unique([hauskreisId, email])
  @@index([hauskreisId])
  @@map("person")
}

model Location {
  id           String   @id @default(uuid()) @db.Uuid
  hauskreisId  String   @map("hauskreis_id") @db.Uuid
  name         String
  /// How often this home should come up relative to the others — the few
  /// central ones far more than the occasional ones further out. The weight
  /// belongs to the home, not to its residents: hosting costs the household,
  /// so two people sharing a flat share one weight rather than getting one each.
  ///
  /// `0` keeps a home on the list without it ever being suggested.
  /// Float rather than Decimal — it only feeds a ranking score, and Decimal
  /// would serialise as a string and force the frontend to parse it.
  hostWeight   Float    @default(1.0) @map("host_weight")
  /// How many people fit. Null means "everyone fits", which is the normal case —
  /// only the tight homes need a number.
  ///
  /// A home that is too small for an evening is set aside for that evening only.
  /// It keeps earning its weight in the meantime, unlike a household that is
  /// away: the opportunity was denied by the guest list, not given up.
  capacity     Int?     @map("capacity")
  /// False for places like the Schlosspark — those meetings have no host at all,
  /// which is a valid state rather than missing data. Host-less places are
  /// outside the fairness ranking entirely: they are a weather-dependent option,
  /// not somewhere that is ever "owed" a turn.
  requiresHost Boolean  @default(true) @map("requires_host")
  /// Wo das ist — für „In Maps öffnen" im Frontend.
  ///
  /// Beide Werte oder keiner: eine Länge ohne Breite zeigt auf nichts. Die
  /// Prüfung sitzt im DTO, weil Prisma keine feldübergreifende Bedingung kennt.
  ///
  /// Float statt Decimal, wie schon bei `hostWeight`: Decimal serialisiert als
  /// String und zwänge das Frontend zum Parsen, bevor es die Zahl in eine
  /// Karten-URL schreiben kann. Ein Double trifft Koordinaten auf rund
  /// zehn Nanometer genau — für ein Wohnzimmer reichlich.
  latitude     Float?   @map("latitude")
  longitude    Float?   @map("longitude")
  /// Optionale Anschrift. Nicht aus den Koordinaten ableitbar und umgekehrt:
  /// zum Navigieren ist der Punkt genauer, zum Vorlesen am Telefon die Adresse.
  address      String?  @map("address")
  /// `address`, auf Vergleichbarkeit getrimmt (siehe `location/address.ts`).
  ///
  /// Das ist der eigentliche Schlüssel eines Zuhauses: „Marienstr. 35" und
  /// „Marienstraße 35" sind dieselbe Wohnung, und genau daran erkennt die App
  /// eine Wohngemeinschaft, wenn die zweite Person ihre Adresse einträgt.
  ///
  /// Der Name taugt dafür nicht (mehr): er wird bei Zuhausen aus den
  /// Bewohner:innen abgeleitet, und zwei Menschen mit demselben Vornamen
  /// ergäben zweimal „Bei Niko".
  addressKey   String?  @map("address_key")
  active       Boolean  @default(true)
  createdAt    DateTime @default(now()) @map("created_at")
  /// Optimistic locking counter, see docs/conditional requests.
  version      Int      @default(0)

  hauskreis Hauskreis @relation(fields: [hauskreisId], references: [id], onDelete: Cascade)
  residents Person[]
  meetings  Meeting[]

  /// Eine Wohnung pro Adresse. `NULL` zählt in Postgres als verschieden, Orte
  /// ohne Anschrift (ein Treffpunkt im Park) dürfen also mehrfach vorkommen.
  @@unique([hauskreisId, addressKey])
  @@index([hauskreisId])
  @@map("location")
}

model Meeting {
  id                  String               @id @default(uuid()) @db.Uuid
  hauskreisId         String               @map("hauskreis_id") @db.Uuid
  date                DateTime             @db.Date
  /// Letzter Tag eines mehrtägigen Termins — eine Freizeit von Freitag bis
  /// Sonntag ist **ein** Abend im Plan, kein Stapel aus dreien. `null` heißt:
  /// ein Tag, der Normalfall.
  ///
  /// Deshalb bleibt auch `@@unique([hauskreisId, date])` auf dem Startdatum:
  /// eine Zeile je Termin. Dass in den Zeitraum kein zweiter fällt, prüft
  /// `MeetingService`, nicht die Datenbank — ein Ausschluss über Bereiche
  /// bräuchte eine Exclusion Constraint, die Prisma nicht ausdrücken kann.
  endDate             DateTime?            @map("end_date") @db.Date
  /// Wann ihr euch trefft, als Minuten seit Mitternacht Ortszeit. 1080 = 18:00.
  ///
  /// Bewusst eine Zahl und kein `@db.Time`: eine Wanduhrzeit ist kein Zeitpunkt.
  /// Prisma reicht `TIME` als `Date` mit erfundenem Datumsteil durch, und der
  /// wäre eine zweite Wahrheit neben `date`. Als Zahl ist sie sortierbar, mit
  /// `0..1439` prüfbar und hat keine Zeitzone, die driften könnte — die steht an
  /// einer einzigen Stelle im Backend (`common/time/local-evening.ts`).
  ///
  /// Pflichtfeld mit Vorgabe: die Gruppe trifft sich zu einer Zeit, und ein
  /// leeres Feld hieße nur „hat noch niemand eingetragen". Automatisch erzeugte
  /// Abende bekommen die Zeit aus `MeetingScheduleConfig`.
  startMinutes        Int                  @default(1080) @map("start_minutes")
  type                MeetingType          @default(STANDARD)
  status              MeetingStatus        @default(PLANNED)
  /// Woraus der Abend besteht. Die vier Schalter sind das, was der **Typ**
  /// vorher nur behauptet hat: geprüft wurde nie etwas, man konnte einem
  /// Lobpreisabend ein Thema geben und einem Geburtstag ein Testimony.
  ///
  /// Jetzt ist der Typ eine Voreinstellung und die Schalter sind die Regel —
  /// STANDARD bringt Thema und Lieder mit, LOBPREIS_GEBET Lieder und
  /// Testimony, CUSTOM gar nichts und alles einzeln zubuchbar. Ein
  /// Geburtstagsabend braucht keine Themenzuteilung, und er soll in der
  /// Fairness-Rechnung des Themas auch nicht mitzählen.
  ///
  /// **Thema, Testimony und Nachbereitung schließen einander paarweise aus**,
  /// aber nicht alle drei gegeneinander. Thema und Testimony, weil beides der
  /// Beitrag ist, um den sich der Abend dreht. Thema und Nachbereitung, weil
  /// beide Zusammenfassung und Actionstep tragen — zwei davon an einem Abend
  /// wären zwei Antworten auf dieselbe Frage. Testimony und Nachbereitung
  /// zusammen sind dagegen genau der Lobpreisabend, an dem jemand erzählt und
  /// die Gruppe danach etwas festhält. Durchgesetzt in `assertSlotsExclusive`.
  ///
  /// Einen Gastgeber-Schalter gibt es bewusst nicht: man trifft sich immer
  /// irgendwo. Dass niemand eingetragen ist (`hostPersonId = null`, Treffen im
  /// Schlosspark) ist davon unberührt und ein gültiger Zustand.
  hasTopicSlot        Boolean              @default(true) @map("has_topic_slot")
  hasSongSlot         Boolean              @default(true) @map("has_song_slot")
  hasTestimonySlot    Boolean              @default(false) @map("has_testimony_slot")
  /// Zusammenfassung und Actionstep **ohne** Thema. Bei jeder Terminart
  /// voreingestellt aus: ein Standard-Abend hat sein Thema, und wo keins ist,
  /// soll die Karte eine Entscheidung sein und keine Vorgabe.
  hasNotesSlot        Boolean              @default(false) @map("has_notes_slot")
  locationId          String?              @map("location_id") @db.Uuid
  hostPersonId        String?              @map("host_person_id") @db.Uuid
  /// Wie der Abend überschrieben ist — „Geburtstag von Mira", aber auch ein
  /// eigener Name für einen ganz normalen Dienstag. Gilt für jede Terminart:
  /// bleibt er leer, steht dort der Titel des Themas und sonst die Art des
  /// Termins (siehe `meetingHeadline` im Frontend).
  title               String?
  /// Wer an diesem Abend sein Testimony erzählt. Nur bei `hasTestimonySlot`.
  ///
  /// Eine Person und kein Text: ein Testimony ist nichts, was man vorher
  /// aufschreibt, sondern jemand, der davon erzählt. Als Textfeld stand es
  /// leer da und niemand wusste, wer es füllen sollte.
  testimonyPersonId   String?              @map("testimony_person_id") @db.Uuid
  /// Was **vor** dem Abend dasteht: „bringt Kuchen mit", „wir fangen später an".
  /// Unabhängig von jedem Baustein und deshalb immer schreibbar.
  infoText            String?              @map("info_text")
  /// Was **nach** dem Abend dasteht — nur bei `hasNotesSlot`.
  ///
  /// Beide Spalten gab es hier schon einmal und sie sind mit den Einheiten
  /// weggezogen. Sie kommen zurück, aber mit anderer Bedeutung: an der
  /// `TopicSession` gehören sie zum **Thema** und überleben einen
  /// Rollenwechsel, hier gehören sie zum **Abend** und gehen mit ihm. Ein
  /// Abend hat entweder das eine oder das andere, nie beides.
  ///
  /// Der Haken darunter steht weiterhin in `MeetingActionstepDone` — der hing
  /// noch nie am Thema, sondern immer am Termin. Genau deshalb funktioniert das
  /// Abhaken hier ohne eine einzige neue Zeile.
  summaryText         String?              @map("summary_text")
  actionstepText      String?              @map("actionstep_text")
  /// Wann der Abend abgesagt wurde. `status` allein sagt nur *dass*, und ein
  /// abgesagter Termin, an dem nichts weiter steht, wirft genau die Fragen auf,
  /// die er beantworten sollte.
  cancelledAt         DateTime?            @map("cancelled_at")
  /// Wer abgesagt hat. `null` bei `ALL_DECLINED` — dann war es niemand.
  cancelledByPersonId String?              @map("cancelled_by_person_id") @db.Uuid
  /// Nicht bloß Buchhaltung: **nur eine automatische Absage wird auch
  /// automatisch zurückgenommen**, sobald wieder jemand zusagt. Eine von Hand
  /// abgesagte bleibt abgesagt, bis ein Mensch etwas anderes sagt.
  cancelSource        MeetingCancelSource? @map("cancel_source")
  cancelReason        String?              @map("cancel_reason")
  createdAt           DateTime             @default(now()) @map("created_at")
  updatedAt           DateTime             @updatedAt @map("updated_at")
  /// Optimistic locking counter, see docs/conditional requests.
  version             Int                  @default(0)

  hauskreis         Hauskreis                 @relation(fields: [hauskreisId], references: [id], onDelete: Cascade)
  location          Location?                 @relation(fields: [locationId], references: [id], onDelete: SetNull)
  host              Person?                   @relation("MeetingHost", fields: [hostPersonId], references: [id], onDelete: SetNull)
  testimonyPerson   Person?                   @relation("MeetingTestimony", fields: [testimonyPersonId], references: [id], onDelete: SetNull)
  cancelledBy       Person?                   @relation("MeetingCanceller", fields: [cancelledByPersonId], references: [id], onDelete: SetNull)
  /// Wer an diesem Abend für das Thema zuständig ist. Die **Zuteilung** — von
  /// der Auswahl darunter getrennt: zugeteilt sein heißt noch nicht, schon
  /// gewählt zu haben (Spec §2, Zustand 3).
  topicResponsibles MeetingTopicResponsible[]
  /// Die gewählte Einheit. Höchstens eine, erzwungen über `@unique` drüben —
  /// das ist zugleich die Absicherung dagegen, dass zwei Zugeteilte im selben
  /// Moment wählen.
  topicSession      TopicSession?
  attendances       MeetingAttendance[]
  songLeaders       MeetingSongLeader[]
  songs             MeetingSong[]
  actionstepDone    MeetingActionstepDone[]
  prayerRequests    MeetingPrayerRequest[]
  notifications     NotificationLog[]

  /// One meeting per date per group — this is what makes the generator idempotent.
  @@unique([hauskreisId, date])
  @@index([hauskreisId, date])
  @@map("meeting")
}

/// Ein Stoff, den die Gruppe durcharbeitet — bewusst **nicht** an einen Abend
/// gebunden. Ein Thema kann sich über mehrere Dienstage ziehen; jeder einzelne
/// davon ist eine `TopicSession`.
///
/// Der Titel ist optional, weil sich nicht jede:r vorab auf einen festlegt, und
/// `summaryText` ist der Überblick über *alle* Einheiten — die Nachbereitung des
/// einzelnen Abends steht an der Einheit.
model Topic {
  id            String      @id @default(uuid()) @db.Uuid
  hauskreisId   String      @map("hauskreis_id") @db.Uuid
  /// Optional — not everyone settles on a title in advance.
  title         String?
  /// Der Bogen über alle Einheiten. Was an *einem* Abend besprochen wurde, steht
  /// in `TopicSession.summaryText`.
  summaryText   String?     @map("summary_text")
  status        TopicStatus @default(RUNNING)
  /// Ein Thema, das keines ist: die Hülle um eine **einzelne Einheit**.
  ///
  /// Nicht jeder Abend spannt einen Bogen. Wer nur einen vorbereiten will,
  /// sollte kein Thema erfinden müssen, das nie ein zweites Mal vorkommt — nach
  /// außen gibt es hier deshalb keins, sondern nur die Einheit.
  ///
  /// Die Zeile steht trotzdem, weil an ihr hängt, was die Einheit ohnehin
  /// braucht: `ownerPersonId` und `TopicCollaborator`, und damit jede Rechte-
  /// und Sichtbarkeitsprüfung aus `topic-visibility.ts`. Ohne sie gäbe es
  /// beides ein zweites Mal, an einer zweiten Tabelle, mit einer zweiten
  /// Gelegenheit auseinanderzulaufen.
  ///
  /// Sie trägt **genau eine** Einheit und keinen Titel. Beides hält der Code
  /// (`createSession`, `choose`), nicht die Datenbank: Der Übergang nach `false`
  /// — jemand vergibt ein Überthema — ist ein einziges `update`, und ein
  /// Datenbank-Zwang, der genau dabei im Weg stünde, wäre teuer erkauft.
  standalone    Boolean     @default(false)
  /// Wem das Thema gehört: wer als Erster eine Einheit dafür gewählt hat, nicht
  /// wer zuerst der Rolle zugeteilt wurde (Spec §3).
  ///
  /// Nullable aus zwei Gründen: Themen aus der Zeit vor diesem Modell haben
  /// keinen, und wer den Hauskreis verlässt, hinterlässt sein Thema statt es
  /// mitzunehmen (`onDelete: SetNull`). Ein Thema ohne Owner und ohne
  /// Collaborator fällt in den dritten Zweig der Hausregel aus `edit-rights.ts`:
  /// dann darf jede:r.
  ownerPersonId String?     @map("owner_person_id") @db.Uuid
  createdAt     DateTime    @default(now()) @map("created_at")
  updatedAt     DateTime    @updatedAt @map("updated_at")
  /// Optimistic locking counter, see docs/conditional requests.
  version       Int         @default(0)

  hauskreis     Hauskreis           @relation(fields: [hauskreisId], references: [id], onDelete: Cascade)
  owner         Person?             @relation("TopicOwner", fields: [ownerPersonId], references: [id], onDelete: SetNull)
  collaborators TopicCollaborator[]
  sessions      TopicSession[]

  @@index([hauskreisId, status])
  @@map("topic")
}

/// Ein Abend eines Themas.
///
/// Der Kern des Modells: die Einheit trägt den Inhalt, nicht der Termin. Damit
/// überlebt eine Vorbereitung jeden Rollenwechsel — entkoppelt wird sie, gelöscht
/// nie (Spec §4).
model TopicSession {
  id             String   @id @default(uuid()) @db.Uuid
  topicId        String   @map("topic_id") @db.Uuid
  /// `null` heißt **unfertig**: vorbereitet, aber (noch) an keinem Abend.
  ///
  /// `@unique` trägt hier zwei Lasten. Fachlich: an einem Abend hängt höchstens
  /// eine Einheit. Technisch: es ist die atomare Absicherung dafür, dass von
  /// zwei gleichzeitig Zugeteilten nur eine:r wählt — der zweite Schreibvorgang
  /// läuft in den Konflikt statt in eine zweite Einheit. Postgres zählt `NULL`
  /// als verschieden, unfertige Einheiten stören sich also nicht.
  meetingId      String?  @unique @map("meeting_id") @db.Uuid
  /// Der Titel dieses Abends innerhalb des Themas („Teil 2: Was Petrus tat").
  title          String?
  actionstepText String?  @map("actionstep_text")
  summaryText    String?  @map("summary_text")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")
  /// Optimistic locking counter, see docs/conditional requests.
  version        Int      @default(0)

  topic        Topic                     @relation(fields: [topicId], references: [id], onDelete: Cascade)
  meeting      Meeting?                  @relation(fields: [meetingId], references: [id], onDelete: SetNull)
  responsibles TopicSessionResponsible[]

  @@index([topicId])
  @@map("topic_session")
}

/// Wer diese Einheit hält oder gehalten hat.
///
/// Eine historische Tatsache, kein Recht: das Bearbeitungsrecht hängt am Thema
/// (`TopicCollaborator`). Wird jemand dort entfernt, bleiben diese Zeilen stehen
/// — „wer war damals dabei" wird nicht rückwirkend gelöscht (Spec 8.5).
model TopicSessionResponsible {
  sessionId String @map("session_id") @db.Uuid
  personId  String @map("person_id") @db.Uuid

  session TopicSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  person  Person       @relation(fields: [personId], references: [id], onDelete: Cascade)

  @@id([sessionId, personId])
  @@index([personId])
  @@map("topic_session_responsible")
}

/// Wer am Thema mitarbeiten darf — das Bearbeitungsrecht, thema-weit.
///
/// Gespeichert und nicht aus den Einheiten abgeleitet: die Ableitung aus Spec 8.4
/// ist „alle Verantwortlichen aller Einheiten **minus** die vom Owner Entfernten",
/// und für dieses Minus bräuchte es ohnehin eine Tabelle. Dann lieber die Menge
/// selbst.
///
/// Eingetragen und entfernt wird **nur vom Owner**, von Hand. Automatisch beim
/// Wählen einer Einheit war es einmal, und das gab jemandem, der einmal aushalf,
/// Hoheit über ein Thema, das über Monate läuft.
///
/// Eine Ausnahme, und sie steht im Code (`membershipOf`), nicht hier: Bei einer
/// **Hülle** zählt die Crew der Einheit mit als Mitwirkende. Dort gibt es kein
/// Thema, von dem jemand ausgeschlossen sein könnte — die Einheit *ist* das
/// Ganze. Abgeleitet und nicht gespeichert, damit eine Zeile in dieser Tabelle
/// weiterhin genau eine Sache bedeutet.
model TopicCollaborator {
  topicId  String @map("topic_id") @db.Uuid
  personId String @map("person_id") @db.Uuid

  topic  Topic  @relation(fields: [topicId], references: [id], onDelete: Cascade)
  person Person @relation(fields: [personId], references: [id], onDelete: Cascade)

  @@id([topicId, personId])
  @@index([personId])
  @@map("topic_collaborator")
}

/// Wer an **diesem Abend** für das Thema zuständig ist — der Zwilling von
/// `MeetingSongLeader`.
///
/// Bis eben gab es diese Tabelle nicht: Zuständigkeit hing am Thema, und damit
/// wechselte ein Rollenwechsel rückwirkend die Zuständigen jedes Abends, an dem
/// das Thema je dran war. Jetzt ist Thema die vierte Rolle mit derselben Mechanik
/// wie die anderen drei, und die Zuteilung ist von der Auswahl getrennt.
model MeetingTopicResponsible {
  meetingId String @map("meeting_id") @db.Uuid
  personId  String @map("person_id") @db.Uuid

  meeting Meeting @relation(fields: [meetingId], references: [id], onDelete: Cascade)
  person  Person  @relation(fields: [personId], references: [id], onDelete: Cascade)

  @@id([meetingId, personId])
  @@index([personId])
  @@map("meeting_topic_responsible")
}

/// A song the group knows. The database grows by itself: whatever gets
/// suggested once stays and can be picked again (CLAUDE.md §6).
///
/// Lyrics are deliberately not stored — only a link to wherever they live.
model Song {
  id                String   @id @default(uuid()) @db.Uuid
  hauskreisId       String   @map("hauskreis_id") @db.Uuid
  title             String
  artist            String?
  lyricsUrl         String?  @map("lyrics_url")
  createdByPersonId String?  @map("created_by_person_id") @db.Uuid
  createdAt         DateTime @default(now()) @map("created_at")
  /// Optimistic locking counter, see docs/conditional requests.
  version           Int      @default(0)

  hauskreis Hauskreis     @relation(fields: [hauskreisId], references: [id], onDelete: Cascade)
  createdBy Person?       @relation("SongCreator", fields: [createdByPersonId], references: [id], onDelete: SetNull)
  pickedIn  MeetingSong[]

  /// Same title *and* artist twice is a duplicate, not a second song. Two songs
  /// sharing a title by different artists stay separate.
  @@unique([hauskreisId, title, artist])
  @@index([hauskreisId])
  @@map("song")
}

/// Wer den Actionstep eines Abends für sich abgehakt hat.
///
/// Eine eigene Tabelle statt eines Häkchens am Termin, weil der Actionstep pro
/// **Person** gilt: „jeden Tag zehn Minuten still werden" nimmt sich jede:r
/// selbst vor, und dass eine Person es geschafft hat, sagt über die anderen
/// acht nichts (CLAUDE.md §6).
///
/// Kein Boolean-Feld, sondern die reine Anwesenheit einer Zeile: abgehakt oder
/// nicht abgehakt, ein dritter Zustand wäre erfunden. `doneAt` ist deshalb
/// nicht nullable — eine Zeile ohne Zeitpunkt gibt es nicht.
model MeetingActionstepDone {
  meetingId String   @map("meeting_id") @db.Uuid
  personId  String   @map("person_id") @db.Uuid
  doneAt    DateTime @default(now()) @map("done_at")

  meeting Meeting @relation(fields: [meetingId], references: [id], onDelete: Cascade)
  person  Person  @relation("ActionstepDoneBy", fields: [personId], references: [id], onDelete: Cascade)

  @@id([meetingId, personId])
  @@index([personId])
  @@map("meeting_actionstep_done")
}

/// Das Gebetsanliegen einer Person für einen Abend.
///
/// **Genau eines je Person und Abend**, und das sagt der zusammengesetzte
/// Schlüssel, nicht eine Prüfung im Dienst. „Wofür sollen wir beten" ist eine
/// Frage, auf die man eine Antwort gibt; eine Liste eigener Anliegen wäre schon
/// die nächste Sache, nämlich ein Notizbuch.
///
/// Lesen darf sie der ganze Hauskreis — dafür stehen sie da. Schreiben nur, wem
/// sie gehört: Ein Gebetsanliegen ist nichts, was ein anderer für einen
/// formuliert, auch kein Admin. Der Endpunkt heißt deshalb `…/mine` und trägt
/// gar keine Personen-Id, die sich fälschen ließe.
///
/// **Anlegen darf jede:r, auch wer an dem Abend fehlt.** Wer nicht kommt, hat
/// nicht weniger Anliegen — eher mehr, und die Bitte, dass die anderen für ihn
/// beten, ist gerade dann der Punkt.
///
/// `updatedAt` und kein `version`: Ändern kann diese Zeile nur eine einzige
/// Person, ein Wettlauf um sie gibt es also nicht.
model MeetingPrayerRequest {
  meetingId String   @map("meeting_id") @db.Uuid
  personId  String   @map("person_id") @db.Uuid
  text      String
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  meeting Meeting @relation(fields: [meetingId], references: [id], onDelete: Cascade)
  person  Person  @relation("PrayerRequestBy", fields: [personId], references: [id], onDelete: Cascade)

  @@id([meetingId, personId])
  @@index([personId])
  @@map("meeting_prayer_request")
}

/// Who looks after the music for one evening. At least one person where there
/// are songs at all, and several are fine (CLAUDE.md §6).
model MeetingSongLeader {
  meetingId String @map("meeting_id") @db.Uuid
  personId  String @map("person_id") @db.Uuid

  meeting Meeting @relation(fields: [meetingId], references: [id], onDelete: Cascade)
  person  Person  @relation("SongLeader", fields: [personId], references: [id], onDelete: Cascade)

  @@id([meetingId, personId])
  @@index([personId])
  @@map("meeting_song_leader")
}

/// A song put forward for one evening. `isSelected` separates the shortlist
/// from what actually gets sung, so a suggestion that did not make it stays
/// visible rather than being deleted.
model MeetingSong {
  id                  String   @id @default(uuid()) @db.Uuid
  meetingId           String   @map("meeting_id") @db.Uuid
  songId              String   @map("song_id") @db.Uuid
  suggestedByPersonId String?  @map("suggested_by_person_id") @db.Uuid
  isSelected          Boolean  @default(false) @map("is_selected")
  createdAt           DateTime @default(now()) @map("created_at")

  meeting     Meeting @relation(fields: [meetingId], references: [id], onDelete: Cascade)
  song        Song    @relation(fields: [songId], references: [id], onDelete: Cascade)
  suggestedBy Person? @relation("SongSuggester", fields: [suggestedByPersonId], references: [id], onDelete: SetNull)

  /// One entry per song per evening — suggesting it twice is the same wish.
  @@unique([meetingId, songId])
  @@index([songId])
  @@map("meeting_song")
}

/// Wann der Hauskreis regelmäßig zusammenkommt — Wochentag und Uhrzeit.
///
/// Beides stand vorher als Konstante im Code (`TUESDAY = 2`, `EVENING_HOUR = 18`)
/// und war damit eine Aussage über *diese* Gruppe in einer App für Gruppen.
///
/// Eine Zeile je Hauskreis, angelegt beim ersten Lesen, und eine eigene Tabelle
/// statt Spalten am `hauskreis` — aus demselben Grund wie beim Gebets-Rhythmus:
/// sie hält fest, *wer* den Rhythmus wann geändert hat.
///
/// Die Vorgaben sind das bisherige Verhalten. Solange niemand etwas einstellt,
/// ändert sich nichts.
model MeetingScheduleConfig {
  id                String   @id @default(uuid()) @db.Uuid
  hauskreisId       String   @unique @map("hauskreis_id") @db.Uuid
  /// 0 = Sonntag … 6 = Samstag, dieselbe Zählung wie `Date.getUTCDay()`.
  weekday           Int      @default(2)
  /// Minuten seit Mitternacht Ortszeit, wie `Meeting.startMinutes`. 1080 = 18:00.
  ///
  /// Die Vorgabe für neue Abende, keine nachträgliche Regel: ein Wechsel
  /// verschiebt nichts, was schon im Kalender steht. Sonst verrückte eine
  /// Einstellung Termine, für die längst jemand zugesagt hat.
  startMinutes      Int      @default(1080) @map("start_minutes")
  /// Die Uhr der Gruppe — ein IANA-Name wie `Europe/Berlin`.
  ///
  /// `startMinutes` ist ohne sie nicht zu deuten, und „welchen Tag haben wir"
  /// ebenso wenig: ein Server in UTC hielt den Termin von gestern bis zwei Uhr
  /// nachts für kommend. Stand als Konstante im Code, bis auffiel, dass das
  /// dieselbe Aussage zu viel war wie vorher Wochentag und Uhrzeit.
  timeZone          String   @default("Europe/Berlin") @map("time_zone")
  updatedByPersonId String?  @map("updated_by_person_id") @db.Uuid
  updatedAt         DateTime @updatedAt @map("updated_at")
  /// Optimistic locking counter, see docs/conditional requests.
  version           Int      @default(0)

  hauskreis Hauskreis @relation(fields: [hauskreisId], references: [id], onDelete: Cascade)
  updatedBy Person?   @relation("MeetingScheduleEditor", fields: [updatedByPersonId], references: [id], onDelete: SetNull)

  @@map("meeting_schedule_config")
}

/// How long a prayer buddy assignment lasts. One row per group, created on
/// first read — a separate table rather than a column on `hauskreis` because it
/// records *who* changed the rhythm and when.
model PrayerBuddyCycleConfig {
  id                String   @id @default(uuid()) @db.Uuid
  hauskreisId       String   @unique @map("hauskreis_id") @db.Uuid
  periodLengthWeeks Int      @default(2) @map("period_length_weeks")
  updatedByPersonId String?  @map("updated_by_person_id") @db.Uuid
  updatedAt         DateTime @updatedAt @map("updated_at")
  /// Optimistic locking counter, see docs/conditional requests.
  version           Int      @default(0)

  hauskreis Hauskreis @relation(fields: [hauskreisId], references: [id], onDelete: Cascade)
  updatedBy Person?   @relation("CycleConfigEditor", fields: [updatedByPersonId], references: [id], onDelete: SetNull)

  @@map("prayer_buddy_cycle_config")
}

/// One prayer buddy group for one period. Several rows share a period —
/// together they are the assignment for that stretch of time.
model PrayerBuddyGroup {
  id          String    @id @default(uuid()) @db.Uuid
  hauskreisId String    @map("hauskreis_id") @db.Uuid
  periodStart DateTime  @map("period_start") @db.Date
  periodEnd   DateTime  @map("period_end") @db.Date
  /// Set when an admin re-rolled before this grouping ever took effect. It is
  /// kept rather than deleted: "not this one" is exactly what the next roll
  /// needs to know, otherwise re-rolling returns the identical grouping.
  /// Hidden from the archive, counted by the repeat avoidance.
  discardedAt DateTime? @map("discarded_at")
  createdAt   DateTime  @default(now()) @map("created_at")

  hauskreis     Hauskreis                @relation(fields: [hauskreisId], references: [id], onDelete: Cascade)
  members       PrayerBuddyGroupMember[]
  notifications NotificationLog[]

  @@index([hauskreisId, periodStart])
  @@map("prayer_buddy_group")
}

model PrayerBuddyGroupMember {
  groupId  String @map("prayer_buddy_group_id") @db.Uuid
  personId String @map("person_id") @db.Uuid
  /// Der Platz im Kreis: **wer hier steht, betet für den auf `(position + 1) %
  /// n`.**
  ///
  /// Eine Zahl und kein Fremdschlüssel auf die Zielperson, weil dieselbe eine
  /// Regel damit beide Gruppengrößen trägt. Ein Paar ist ein Kreis aus zwei —
  /// 0 betet für 1, 1 für 0, also füreinander, ohne Sonderfall. Ein Trio ist
  /// derselbe Kreis, nur länger, und dort sagt die Richtung dann wirklich etwas:
  /// A betet für B, B für C, C für A.
  ///
  /// Ein zweites Feld „betet für" wäre ein zweiter Ort für dieselbe Aussage —
  /// und damit eine Gelegenheit, dass beide auseinanderlaufen.
  position Int

  group  PrayerBuddyGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)
  person Person           @relation("PrayerBuddy", fields: [personId], references: [id], onDelete: Cascade)

  @@id([groupId, personId])
  /// Ein Kreis ist nur dann einer, wenn jede Position genau einmal vorkommt.
  @@unique([groupId, position])
  @@index([personId])
  @@map("prayer_buddy_group_member")
}

/// "Ich bin vom … bis … weg." Both ends inclusive.
///
/// The single source of truth for a stretch of time. What it produces —
/// `meeting_attendance` rows for the evenings it covers — is derived and can be
/// rebuilt from here at any point, which is what makes editing the period safe.
model AbsencePeriod {
  id          String   @id @default(uuid()) @db.Uuid
  hauskreisId String   @map("hauskreis_id") @db.Uuid
  personId    String   @map("person_id") @db.Uuid
  startDate   DateTime @map("start_date") @db.Date
  /// Inclusive: away "bis 24." means the 24th is still covered. A one-day
  /// absence has the same value on both ends.
  endDate     DateTime @map("end_date") @db.Date
  reason      String?
  createdAt   DateTime @default(now()) @map("created_at")
  /// Optimistic locking counter, see docs/conditional requests.
  version     Int      @default(0)

  hauskreis Hauskreis @relation(fields: [hauskreisId], references: [id], onDelete: Cascade)
  person    Person    @relation(fields: [personId], references: [id], onDelete: Cascade)

  /// Overlapping periods are allowed on purpose — two trips that touch simply
  /// union. Forbidding it would make editing one of them needlessly fiddly.
  @@index([hauskreisId, startDate, endDate])
  @@index([personId])
  @@map("absence_period")
}

/// One Web Push endpoint, i.e. one browser on one device. People install the
/// PWA on several devices, so a person can have many.
model PushSubscription {
  id        String   @id @default(uuid()) @db.Uuid
  personId  String   @map("person_id") @db.Uuid
  /// The push service URL. Unique because re-subscribing in the same browser
  /// yields the same endpoint and must update rather than duplicate.
  endpoint  String   @unique
  p256dhKey String   @map("p256dh_key")
  authKey   String   @map("auth_key")
  userAgent String?  @map("user_agent")
  createdAt DateTime @default(now()) @map("created_at")

  person Person @relation(fields: [personId], references: [id], onDelete: Cascade)

  @@index([personId])
  @@map("push_subscription")
}

/// Records that a notification was sent, so a job that runs daily does not
/// remind the same person about the same meeting over and over.
model NotificationLog {
  id                    String           @id @default(uuid()) @db.Uuid
  personId              String           @map("person_id") @db.Uuid
  type                  NotificationType
  relatedMeetingId      String?          @map("related_meeting_id") @db.Uuid
  /// What a prayer buddy notification refers to. Without it every rotation
  /// would look like the same notification as the first one, and only the very
  /// first assignment would ever be announced.
  relatedGroupId        String?          @map("related_group_id") @db.Uuid
  /// Who the notification is *about*, when that is somebody other than the
  /// recipient. A host hearing "Antonia cancelled" would otherwise be told
  /// about the first drop-out only: the meeting alone is not specific enough
  /// to tell two cancellations for the same evening apart.
  relatedPersonId       String?          @map("related_person_id") @db.Uuid
  /// Welche Rolle gemeint war. Nur `ROLE_ASSIGNED` benutzt das — und braucht es:
  /// wer an einem Abend Gastgeber **und** für die Musik eingeteilt wird, soll
  /// zweimal hören, dass er dran ist. Der Termin allein ist dafür nicht
  /// unterscheidbar genug.
  relatedRole           AssignmentRole?  @map("related_role")
  /// Welche Fassung der App angekündigt wurde. Nur `RELEASE_NOTES` benutzt das.
  ///
  /// Ohne diese Spalte wären bei einer Ankündigung alle vier Felder darüber
  /// leer, und die Entdopplung ließe je Person **genau eine** durch — für
  /// immer. Der zweite Release käme nie an.
  ///
  /// Keine Beziehung, weil es keine Tabelle dazu gibt: Die Releases stehen in
  /// `src/release/releases.ts` und gehören zum Programm, nicht zu den Daten.
  /// Dieselbe Spalte beantwortet nebenbei „ist diese Fassung überhaupt schon
  /// angekündigt worden?" — siehe `ReleaseAnnouncementService`.
  relatedReleaseVersion String?          @map("related_release_version")
  /// Welcher Geburtstag gemeint war — also die Runde, nicht die Person.
  ///
  /// Ohne diese Spalte wäre die Erinnerung „du besorgst das Geschenk für
  /// Mira" in jedem Jahr dieselbe Nachricht wie im ersten, und sie käme genau
  /// einmal im Leben an. `relatedPersonId` reicht dafür nicht: Mira hat jedes
  /// Jahr Geburtstag.
  relatedOccasionId     String?          @map("related_occasion_id") @db.Uuid
  sentAt                DateTime         @default(now()) @map("sent_at")

  person          Person            @relation(fields: [personId], references: [id], onDelete: Cascade)
  relatedMeeting  Meeting?          @relation(fields: [relatedMeetingId], references: [id], onDelete: Cascade)
  relatedGroup    PrayerBuddyGroup? @relation(fields: [relatedGroupId], references: [id], onDelete: Cascade)
  relatedPerson   Person?           @relation("NotificationSubject", fields: [relatedPersonId], references: [id], onDelete: Cascade)
  relatedOccasion BirthdayOccasion? @relation(fields: [relatedOccasionId], references: [id], onDelete: Cascade)

  /// The deduplication key. Postgres treats rows with a NULL in the tuple as
  /// distinct, so this index does not actually enforce anything for
  /// notifications without a meeting — the real check is the query in
  /// `NotificationService.hasBeenSent`. The index still earns its keep by
  /// making that query an index lookup.
  /// Der Name ist gesetzt, weil der abgeleitete abgeschnitten würde und sich
  /// mit jeder weiteren Spalte änderte.
  @@unique([personId, type, relatedMeetingId, relatedGroupId, relatedPersonId, relatedRole, relatedReleaseVersion, relatedOccasionId], map: "notification_log_dedup_key")
  @@index([personId, sentAt])
  /// Beantwortet „wurde diese Fassung schon angekündigt?" ohne über alle Zeilen
  /// zu gehen. Ohne diese Frage bekäme jemand, der nächste Woche dazukommt,
  /// beim nächsten Neustart eine Ankündigung für längst Vorhandenes.
  @@index([type, relatedReleaseVersion])
  @@map("notification_log")
}

/// A person's deviation from the default for one notification type.
///
/// Only differences are stored — no row means "as the catalog says". That is
/// what lets a new notification type ship without backfilling a row per person:
/// it is simply on for everyone from the deploy onwards.
model NotificationPreference {
  id        String           @id @default(uuid()) @db.Uuid
  personId  String           @map("person_id") @db.Uuid
  type      NotificationType
  enabled   Boolean          @default(true)
  /// Days before the meeting, for the reminders tied to one. Null keeps the
  /// catalog default; meaningless for event-driven types.
  leadDays  Int?             @map("lead_days")
  /// Wochentage für die wiederkehrenden Erinnerungen, 0 = Sonntag.
  ///
  /// Eine Liste, weil ein Actionstep mehr als eine Nachfrage pro Woche
  /// verträgt — einmal zur Wochenmitte und einmal kurz vor dem nächsten
  /// Abend ist etwas anderes als zweimal dasselbe.
  ///
  /// Leer heißt „wie im Katalog", nicht „nie": Letzteres sagt `enabled`.
  /// Für alle anderen Arten ohne Bedeutung.
  weekdays  Int[]
  updatedAt DateTime         @updatedAt @map("updated_at")

  person Person @relation(fields: [personId], references: [id], onDelete: Cascade)

  @@unique([personId, type])
  @@map("notification_preference")
}

model MeetingAttendance {
  meetingId String           @map("meeting_id") @db.Uuid
  personId  String           @map("person_id") @db.Uuid
  status    AttendanceStatus @default(UNKNOWN)
  /// Who put this answer here. An absence period writes rows on the person's
  /// behalf, and without this column a later re-sync could not tell them from a
  /// deliberate "doch, ich komme" and would silently overwrite it.
  source    AttendanceSource @default(SELF)
  updatedAt DateTime         @updatedAt @map("updated_at")

  meeting Meeting @relation(fields: [meetingId], references: [id], onDelete: Cascade)
  person  Person  @relation(fields: [personId], references: [id], onDelete: Cascade)

  @@id([meetingId, personId])
  @@index([personId])
  @@map("meeting_attendance")
}

/// Welcher Bildschirm ein eigenes Kopfbild hat.
///
/// „Termine" fehlt mit Absicht: dort liest man eine Liste über Wochen hinweg,
/// und ein Foto über der Tabelle wäre nur Weg bis zur ersten Zeile.
enum HeaderScreen {
  HOME
  PRAYER
  ARCHIVE
  PROFILE
}

/// Das Hintergrundbild im Kopfbereich eines Bildschirms.
///
/// Eine Zeile je Bildschirm und Gruppe; **keine Zeile heißt: der mitgelieferte
/// Verlauf steht da.** Kein `NULL`-Zustand also, den man von „noch nie gesetzt"
/// unterscheiden müsste — wer das Bild entfernt, entfernt die Zeile.
///
/// Die Datei selbst liegt im Volume (`UPLOAD_DIR/headers/…`), wie bei den
/// Profilbildern: ein Bild ist kein Datensatz, den man abfragt, sondern ein
/// Blob, den man ausliefert. Gespeichert wird hier nur `updatedAt` — der hängt
/// als Query-Parameter an der Bild-URL und erledigt das Zwischenspeichern im
/// Browser.
model HeaderImage {
  id          String       @id @default(uuid()) @db.Uuid
  hauskreisId String       @map("hauskreis_id") @db.Uuid
  screen      HeaderScreen
  updatedAt   DateTime     @updatedAt @map("updated_at")

  hauskreis Hauskreis @relation(fields: [hauskreisId], references: [id], onDelete: Cascade)

  @@unique([hauskreisId, screen])
  @@map("header_image")
}

// ───────────────────────────────────────────────────────────────────────────
// Geburtstage und Geschenke
// ───────────────────────────────────────────────────────────────────────────

/// Wie die Zuständigkeit für ein Geburtstagsgeschenk zustande kommt.
///
/// `ROTATING` rechnet sie aus den Geburtstagen selbst: Wer dran war, ist für
/// den zuständig, dessen Geburtstag als nächstes kommt. Damit ist in einer
/// Runde — einem Jahr — jede:r genau einmal dran, und niemand für sich selbst.
///
/// `MANUAL` nimmt stattdessen die feste Zuteilung aus `BirthdayGiftPairing`.
/// Sie bleibt Runde für Runde dieselbe, bis ein Admin sie ändert.
enum BirthdayGiftMode {
  ROTATING
  MANUAL

  @@map("birthday_gift_mode")
}

/// Ob und wie sich die Gruppe zu Geburtstagen beschenkt. Eine Zeile je
/// Hauskreis, beim ersten Lesen angelegt — wie `PrayerBuddyCycleConfig`.
///
/// **`enabled` steht mit Absicht auf `false`.** Nicht jeder Hauskreis schenkt
/// sich etwas, und ein System, das ungefragt Zuständigkeiten verteilt und
/// Nachrichten verschickt, wäre für die ein Ärgernis statt einer Hilfe. Die
/// Geburtstage selbst stehen trotzdem im Kalender — das ist die Hälfte, die
/// niemanden zu etwas verpflichtet.
model BirthdayGiftConfig {
  id                 String           @id @default(uuid()) @db.Uuid
  hauskreisId        String           @unique @map("hauskreis_id") @db.Uuid
  enabled            Boolean          @default(false)
  mode               BirthdayGiftMode @default(ROTATING)
  /// Wie viele Tage vor einem Geburtstag die Zuteilung fest wird.
  ///
  /// Wer eine Woche vorher erfährt, dass er doch nicht zuständig ist, hat
  /// vielleicht schon etwas besorgt. Ab hier ändert sich nichts mehr, auch
  /// nicht durch einen Moduswechsel oder einen neu eingetragenen Geburtstag.
  freezeDays         Int              @default(14) @map("freeze_days")
  /// Wann das System eine manuelle Zuteilung zuletzt selbst schließen musste.
  ///
  /// Bei `MANUAL` hängt die Zuteilung an Namen, und Namen kommen und gehen.
  /// Wer geht, reißt ein Loch — und das System füllt es, statt jemanden ohne
  /// Zuständigen dastehen zu lassen. Der Zeitstempel ist der Anlass für den
  /// Hinweis in der Verwaltung: **es steht jetzt etwas da, das kein Mensch
  /// entschieden hat.** Ein Admin räumt ihn weg, indem er die Zuteilung
  /// bestätigt.
  pairingsRepairedAt DateTime?        @map("pairings_repaired_at")
  updatedByPersonId  String?          @map("updated_by_person_id") @db.Uuid
  updatedAt          DateTime         @updatedAt @map("updated_at")
  /// Optimistic locking counter, see docs/conditional requests.
  version            Int              @default(0)

  hauskreis Hauskreis @relation(fields: [hauskreisId], references: [id], onDelete: Cascade)
  updatedBy Person?   @relation("BirthdayGiftConfigEditor", fields: [updatedByPersonId], references: [id], onDelete: SetNull)

  @@map("birthday_gift_config")
}

/// Die feste Zuteilung im Modus `MANUAL`: wer besorgt das Geschenk für wen.
///
/// Der Schlüssel liegt auf dem **Beschenkten**, nicht auf dem Schenkenden: Für
/// jeden Geburtstag gibt es genau eine zuständige Person, umgekehrt darf jemand
/// auch für zwei zuständig sein. Der Admin darf das so wollen — nur „für sich
/// selbst" prüft der Dienst weg.
model BirthdayGiftPairing {
  hauskreisId         String @map("hauskreis_id") @db.Uuid
  birthdayPersonId    String @map("birthday_person_id") @db.Uuid
  responsiblePersonId String @map("responsible_person_id") @db.Uuid

  hauskreis      Hauskreis @relation(fields: [hauskreisId], references: [id], onDelete: Cascade)
  birthdayPerson Person    @relation("GiftPairingFor", fields: [birthdayPersonId], references: [id], onDelete: Cascade)
  responsible    Person    @relation("GiftPairingBy", fields: [responsiblePersonId], references: [id], onDelete: Cascade)

  @@id([hauskreisId, birthdayPersonId])
  @@index([responsiblePersonId])
  @@map("birthday_gift_pairing")
}

/// **Ein** Geburtstag einer Person in **einem** Jahr — und wer das Geschenk
/// besorgt.
///
/// **Warum die Zuständigkeit hier steht und nicht bei jedem Aufruf gerechnet
/// wird.** Gerechnet wird sie, aber das Ergebnis muss stehen bleiben: Ein
/// Geburtstag, der vorbei ist, gehört zur Geschichte („wen hattest du in den
/// letzten Runden"), und ein Geburtstag, der bald ist, darf nicht mehr
/// wechseln, weil jemand heute seinen Geburtstag einträgt. Beides ginge nicht,
/// wenn die Antwort erst beim Lesen entstünde.
///
/// **Es gibt immer genau eine offene Zeile je Person**, nämlich ihr nächster
/// Geburtstag; ältere bleiben als Geschichte stehen. Deshalb reicht
/// `@@unique([personId, occursOn])` — dieselbe Person, dasselbe Datum, eine
/// Zeile, und der nächtliche Lauf darf beliebig oft laufen.
///
/// `responsiblePersonId` darf leer sein. Das ist kein Fehlerzustand, sondern
/// der ehrliche Ausgang mehrerer Fälle: Das System ist ausgeschaltet, es gibt
/// zu wenige Leute mit eingetragenem Geburtstag, oder die Person, die
/// zuständig war, hat den Hauskreis verlassen und es ließ sich niemand mehr
/// nachrücken.
model BirthdayOccasion {
  id                  String   @id @default(uuid()) @db.Uuid
  hauskreisId         String   @map("hauskreis_id") @db.Uuid
  personId            String   @map("person_id") @db.Uuid
  /// Der Kalendertag dieses Geburtstags — mit Jahr, anders als `person.birthdate`.
  occursOn            DateTime @map("occurs_on") @db.Date
  responsiblePersonId String?  @map("responsible_person_id") @db.Uuid
  /// Welcher Vorschlag es geworden ist. Setzt ihn die zuständige Person, ist
  /// die Abstimmung beendet; sie kann das zurücknehmen, solange nicht
  /// eingefroren ist.
  selectedGiftIdeaId  String?  @map("selected_gift_idea_id") @db.Uuid
  /// Was es gekostet hat, in Cent. Ganzzahlig, weil Geld nie als Fließkomma.
  ///
  /// Steht hier etwas, gilt die Zuteilung als **eingefroren**, auch außerhalb
  /// der Frist: Wer schon etwas besorgt und den Preis eingetragen hat, soll
  /// nicht hinterher hören, dass jemand anders zuständig war.
  priceCents          Int?     @map("price_cents")
  createdAt           DateTime @default(now()) @map("created_at")
  updatedAt           DateTime @updatedAt @map("updated_at")
  /// Optimistic locking counter, see docs/conditional requests.
  version             Int      @default(0)

  hauskreis     Hauskreis         @relation(fields: [hauskreisId], references: [id], onDelete: Cascade)
  person        Person            @relation("BirthdayOf", fields: [personId], references: [id], onDelete: Cascade)
  responsible   Person?           @relation("BirthdayGiftBy", fields: [responsiblePersonId], references: [id], onDelete: SetNull)
  selectedIdea  GiftIdea?         @relation("GiftIdeaChosen", fields: [selectedGiftIdeaId], references: [id], onDelete: SetNull)
  notifications NotificationLog[]

  @@unique([personId, occursOn])
  @@index([hauskreisId, occursOn])
  @@index([responsiblePersonId])
  @@map("birthday_occasion")
}

/// Ein Geschenk-Vorschlag — für **eine Person**, nicht für einen Geburtstag.
///
/// Das ist die eigentliche Entscheidung an diesem Modell. Vorschläge überleben
/// den Geburtstag, für den sie gemacht wurden: Was letztes Jahr nicht genommen
/// wurde, ist dieses Jahr immer noch eine gute Idee, und was genommen wurde,
/// muss man wissen, um es nicht zweimal zu schenken. Hinge der Vorschlag am
/// Geburtstag, wäre er mit ihm weg.
model GiftIdea {
  id                 String   @id @default(uuid()) @db.Uuid
  hauskreisId        String   @map("hauskreis_id") @db.Uuid
  /// Für wen das Geschenk gedacht ist.
  forPersonId        String   @map("for_person_id") @db.Uuid
  text               String
  /// Wo man es bekommt. Der Inhalt wird nie gespeichert, wir verlinken nach
  /// draußen — wie bei den Liedern.
  url                String?
  proposedByPersonId String?  @map("proposed_by_person_id") @db.Uuid
  createdAt          DateTime @default(now()) @map("created_at")

  hauskreis  Hauskreis          @relation(fields: [hauskreisId], references: [id], onDelete: Cascade)
  forPerson  Person             @relation("GiftIdeaFor", fields: [forPersonId], references: [id], onDelete: Cascade)
  proposedBy Person?            @relation("GiftIdeaBy", fields: [proposedByPersonId], references: [id], onDelete: SetNull)
  votes      GiftIdeaVote[]
  chosenAt   BirthdayOccasion[] @relation("GiftIdeaChosen")

  @@index([hauskreisId, forPersonId])
  @@map("gift_idea")
}

/// Eine Zustimmung zu einem Vorschlag.
///
/// Kein Feld mit einer Zahl, sondern die bloße Anwesenheit einer Zeile — wie
/// bei `MeetingActionstepDone`: zugestimmt oder nicht, ein dritter Zustand wäre
/// erfunden. Mehrere Vorschläge darf man gut finden; bei Geschenken sind oft
/// zwei brauchbar und einer scheidet aus.
model GiftIdeaVote {
  giftIdeaId String   @map("gift_idea_id") @db.Uuid
  personId   String   @map("person_id") @db.Uuid
  createdAt  DateTime @default(now()) @map("created_at")

  giftIdea GiftIdea @relation(fields: [giftIdeaId], references: [id], onDelete: Cascade)
  person   Person   @relation("GiftIdeaVoter", fields: [personId], references: [id], onDelete: Cascade)

  @@id([giftIdeaId, personId])
  @@index([personId])
  @@map("gift_idea_vote")
}
