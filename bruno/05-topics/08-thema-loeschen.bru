meta {
  name: Thema löschen
  type: http
  seq: 8
}

delete {
  url: {{baseUrl}}/hauskreise/{{hauskreisId}}/topics/{{topicId}}
  body: none
  auth: inherit
}

tests {
  test("antwortet mit 204", function () {
    expect(res.getStatus()).to.equal(204);
  });
}

docs {
  Nur der **Owner** (und Admins). Ein Mitarbeiter darf jeden Text ändern, aber
  nicht die Arbeit aller wegräumen. Ein Thema ohne Owner und ohne Mitarbeitende
  darf jedes Mitglied löschen — sonst wäre es für immer unantastbar.

  Alle Einheiten gehen mit, samt Zusammenfassungen und Actionsteps. Die Abende
  selbst bleiben stehen und fallen auf „zugeteilt, aber noch nichts gewählt"
  zurück — die Zuteilung steht am Termin und hatte mit dem Thema nie etwas zu
  tun.
}
