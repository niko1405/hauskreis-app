meta {
  name: Thema anlegen
  type: http
  seq: 2
}

post {
  url: {{baseUrl}}/hauskreise/{{hauskreisId}}/topics
  body: json
  auth: inherit
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "title": "Bruno-Testthema",
    "responsiblePersonIds": ["{{myPersonId}}"]
  }
}

script:post-response {
  bru.setEnvVar("topicId", res.body.id);
  bru.setEnvVar("topicEtag", res.getHeader("etag"));
}

tests {
  test("antwortet mit 201", function () {
    expect(res.getStatus()).to.equal(201);
  });
}
