meta {
  name: Themen auflisten
  type: http
  seq: 1
}

get {
  url: {{baseUrl}}/hauskreise/{{hauskreisId}}/topics?take=10
  body: none
  auth: inherit
}

params:query {
  take: 10
}

script:post-response {
  if (res.body.items.length) bru.setEnvVar("topicId", res.body.items[0].id);
}

tests {
  test("antwortet mit 200", function () {
    expect(res.getStatus()).to.equal(200);
  });

  test("liefert einen Paginierungs-Umschlag", function () {
    expect(res.body).to.have.property("items");
    expect(res.body).to.have.property("total");
    expect(res.body).to.have.property("hasMore");
  });
}

docs {
  Ohne `scope` gilt `public`: Themen, von denen mindestens ein Abend vorbei ist.
  Ein frisch angelegtes steht hier also nicht — es taucht erst auf, wenn sein
  erster Abend war. Bis dahin findet man es über `scope=mine`.
}
