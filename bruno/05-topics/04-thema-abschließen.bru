meta {
  name: Thema abschließen
  type: http
  seq: 4
}

patch {
  url: {{baseUrl}}/hauskreise/{{hauskreisId}}/topics/{{topicId}}
  body: json
  auth: inherit
}

headers {
  If-Match: {{topicEtag}}
  Content-Type: application/json
}

body:json {
  {
    "status": "COMPLETED"
  }
}

script:post-response {
  bru.setEnvVar("topicEtag", res.getHeader("etag"));
}

tests {
  test("antwortet mit 200", function () {
    expect(res.getStatus()).to.equal(200);
  });
}

docs {
  So wird ein Thema als erledigt markiert — danach schlägt die App ein neues vor.
}
