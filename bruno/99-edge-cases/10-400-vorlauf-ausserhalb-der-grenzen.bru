meta {
  name: 400 Vorlauf außerhalb der Grenzen
  type: http
  seq: 10
}

put {
  url: {{baseUrl}}/push/settings/HOST_REMINDER
  body: json
  auth: inherit
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "leadDays": 30
  }
}

tests {
  test("hält sich an die Grenzen aus dem Katalog", function () {
    expect(res.getStatus()).to.equal(400);
  });
}

docs {
  Die Grenzen stehen pro Typ im Katalog, nicht im DTO — ein einzelnes
  Zod-Schema weiß nicht, welchen Typ es gerade validiert.
}
