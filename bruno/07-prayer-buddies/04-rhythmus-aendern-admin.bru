meta {
  name: Rhythmus ändern (admin)
  type: http
  seq: 4
}

put {
  url: {{baseUrl}}/hauskreise/{{hauskreisId}}/prayer-buddies/config
  body: json
  auth: inherit
}

headers {
  If-Match: {{buddyConfigEtag}}
  Content-Type: application/json
}

body:json {
  {
    "periodLengthWeeks": 2
  }
}

script:post-response {
  bru.setEnvVar("buddyConfigEtag", res.getHeader("etag"));
}

tests {
  test("antwortet mit 200", function () {
    expect(res.getStatus()).to.equal(200);
  });
}

docs {
  Gilt ab der nächsten Rotation — der laufenden Zuteilung werden nicht
  die Daten unter den Füßen weggezogen.
}
