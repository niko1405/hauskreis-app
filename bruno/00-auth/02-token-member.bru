meta {
  name: Token holen (member)
  type: http
  seq: 2
}

post {
  url: {{keycloakUrl}}/realms/{{realm}}/protocol/openid-connect/token
  body: formUrlEncoded
  auth: none
}

body:form-urlencoded {
  client_id: {{clientId}}
  client_secret: {{clientSecret}}
  username: {{memberUser}}
  password: {{password}}
  grant_type: password
}

script:post-response {
  bru.setEnvVar("memberToken", res.body.access_token);
}

tests {
  test("liefert ein Token", function () {
    expect(res.getStatus()).to.equal(200);
  });
}

docs {
  Setzt {{memberToken}} — gebraucht in 99-edge-cases, um zu prüfen, dass
  Admin-Routen für Mitglieder mit 403 antworten.
}
