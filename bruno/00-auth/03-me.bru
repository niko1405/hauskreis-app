meta {
  name: GET /me
  type: http
  seq: 3
}

get {
  url: {{baseUrl}}/me
  body: none
  auth: inherit
}

script:post-response {
  bru.setEnvVar("myPersonId", res.body.id);
  bru.setEnvVar("hauskreisId", res.body.hauskreisId);
}

tests {
  test("verknüpft den Account mit einer Person", function () {
    expect(res.getStatus()).to.equal(200);
    expect(res.body.id).to.be.a("string");
  });

  test("liefert die Realm-Rollen mit", function () {
    expect(res.body.roles).to.be.an("array");
  });
}

docs {
  Beim ersten Login wird hier über die E-Mail verknüpft. Setzt
  {{myPersonId}} und {{hauskreisId}} für den Rest der Collection.
}
