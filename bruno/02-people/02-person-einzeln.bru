meta {
  name: Person einzeln
  type: http
  seq: 2
}

get {
  url: {{baseUrl}}/hauskreise/{{hauskreisId}}/people/{{myPersonId}}
  body: none
  auth: inherit
}

script:post-response {
  bru.setEnvVar("myPersonEtag", res.getHeader("etag"));
}

tests {
  test("antwortet mit 200", function () {
    expect(res.getStatus()).to.equal(200);
  });
  test("liefert einen ETag zum Schreiben", function () {
    expect(res.getHeader("etag")).to.be.a("string");
  });
}
