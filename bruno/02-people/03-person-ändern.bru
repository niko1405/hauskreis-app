patch {
  url: {{baseUrl}}/hauskreise/{{hauskreisId}}/people/{{myPersonId}}
  body: json
  auth: inherit
}

headers {
  If-Match: {{myPersonEtag}}
  Content-Type: application/json
}

body:json {
  {
    "playsInstrument": true
  }
}

tests {
  test("antwortet mit 200", function () {
    expect(res.getStatus()).to.equal(200);
  });
}

