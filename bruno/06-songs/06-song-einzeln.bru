meta {
  name: Song einzeln
  type: http
  seq: 6
}

get {
  url: {{baseUrl}}/hauskreise/{{hauskreisId}}/songs/{{newSongId}}
  body: none
  auth: inherit
}

script:post-response {
  bru.setEnvVar("songEtag", res.getHeader("etag"));
}

tests {
  test("antwortet mit 200", function () {
    expect(res.getStatus()).to.equal(200);
  });
}
